{
  "manifest_version": 3,
  "name": "SandClaw.ai PeerShare Proxy",
  "short_name": "PeerShare Proxy",
  "description": "Lets PeerShare (peershare.sandclaw.ai) reach services on this computer and your local network, without the proxy script.",
  "version": "@VERSION@",
  "homepage_url": "https://peershare.sandclaw.ai/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SandClaw.ai PeerShare Proxy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://peershare.sandclaw.ai/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
